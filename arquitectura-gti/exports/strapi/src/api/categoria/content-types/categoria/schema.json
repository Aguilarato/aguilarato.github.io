{
  "kind": "collectionType",
  "collectionName": "categorias",
  "info": {
    "singularName": "categoria",
    "pluralName": "categorias",
    "displayName": "Categoría",
    "description": "Taxonomía de navegación: categorías del menú principal, accesos del encabezado e información legal del pie."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "nombre": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nombre"
    },
    "descripcion": {
      "type": "text"
    },
    "orden": {
      "type": "integer"
    },
    "ubicacion": {
      "type": "enumeration",
      "enum": [
        "menu_principal",
        "encabezado",
        "pie"
      ],
      "default": "menu_principal",
      "required": true
    },
    "paginas": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::pagina.pagina",
      "mappedBy": "categoria"
    }
  }
}